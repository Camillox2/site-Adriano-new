{
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        }
      ]
    },
    {
      "source": "/static/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/hifu",
      "destination": "/hifu/",
      "permanent": true
    },
    {
      "source": "/blog/mitos-sobre-o-acido-hialuronico",
      "destination": "/blog/mitos-sobre-o-acido-hialuronico/",
      "permanent": true
    },
    {
      "source": "/servicos/curitiba{/}?",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/:service(odontologia-estetica|implantes-dentarios|ortodontia|harmonizacao-orofacial|dtm-dor-orofacial|ozonioterapia|aluguel-de-hifu|lipo-de-papada-hifu)-sao-lourenco-do-oeste{/}?",
      "destination": "/:service/",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/((?!.*\\.(?:xml|txt|ico|png|jpg|jpeg|svg|webp|json|css|js|mp4|webm)$).*)",
      "destination": "/index.html"
    }
  ]
}
